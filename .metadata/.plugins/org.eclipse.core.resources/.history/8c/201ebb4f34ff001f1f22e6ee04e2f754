package com.transaction.service;

import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.kafka.core.KafkaTemplate;

import com.transaction.config.TransactionConstants;

public class KafkaService {

	@Autowired
	private KafkaTemplate< String,Integer> kafkaTemplate;

	private org.slf4j.Logger logger = LoggerFactory.getLogger(KafkaService.class);

	public boolean updateTransaction(int amt) {
		this.kafkaTemplate.send(TransactionConstants.TRANSACTION_TOPIC_NAME, amt);
		this.logger.info("Transaction produced");
		return true;
	}

}
